# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.fseventsd

# Editors and IDEs
.claude/
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# Quarto build artifacts
.quarto/
_freeze/
*_files/
*_cache/

# Quarto output directory (built by GitHub Actions, deployed to Cloudflare Pages)
docs/

# Quarto search index (generated)
search.json

# LaTeX intermediate files (generated during PDF build)
*.aux
*.bbl
*.blg
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# Backup and temporary files
*~
*.bak
*.swp
*.swo
*.tmp

# Environment and secrets (just in case)
.env
.env.*
*.key
*.pem
secrets.yml
credentials.json

# Local development
local-notes/
drafts/
scratch/

# Log files
*.log

/.quarto/
**/*.quarto_ipynb

# Raw meet files — these carry minors' birthdates and must never reach a public
# repo. Portfolio-wide policy, applied to every public repo regardless of whether
# it has any reason to hold one: the repos nobody expects to receive a meet file
# are where a misdirected write would go unnoticed longest.
*.sd3
*.SD3
*.hy3
*.HY3
*.cl2
*.CL2
*.zip
*.ZIP
